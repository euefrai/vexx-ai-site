# --- Supabase ---
# Project URL (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Anon public key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server only — NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (server only)
STRIPE_SECRET_KEY=
# Webhook signing secret (after registering /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# Price IDs (created in Stripe dashboard for each plan)
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_PREMIUM=

# --- App ---
# Public URL of the app (used by Stripe redirects + auth callback)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
